<?xml version="1.0" encoding="UTF-8"?>
<!-- Semantic description: UR10e (from ur_moveit_config) + pedestal + suction gripper. -->
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="palletizer">
  <xacro:include filename="$(find ur_moveit_config)/srdf/ur_macro.srdf.xacro"/>
  <xacro:ur_srdf/>

  <group name="manipulator">
    <chain base_link="base_link" tip_link="suction_tcp"/>
  </group>

  <group_state name="park" group="manipulator">
    <joint name="shoulder_pan_joint" value="-1.5708"/>
    <joint name="shoulder_lift_joint" value="-1.5708"/>
    <joint name="elbow_joint" value="1.5708"/>
    <joint name="wrist_1_joint" value="-1.5708"/>
    <joint name="wrist_2_joint" value="-1.5708"/>
    <joint name="wrist_3_joint" value="0"/>
  </group_state>

  <!-- pedestal and gripper -->
  <disable_collisions link1="pedestal" link2="base_link" reason="Adjacent"/>
  <disable_collisions link1="pedestal" link2="base_link_inertia" reason="Adjacent"/>
  <disable_collisions link1="pedestal" link2="shoulder_link" reason="Never"/>
  <disable_collisions link1="suction_body" link2="wrist_3_link" reason="Adjacent"/>
  <disable_collisions link1="suction_body" link2="wrist_2_link" reason="Never"/>
  <disable_collisions link1="suction_body" link2="wrist_1_link" reason="Never"/>
  <disable_collisions link1="suction_body" link2="suction_cup" reason="Adjacent"/>
  <disable_collisions link1="suction_cup" link2="wrist_3_link" reason="Never"/>
  <disable_collisions link1="suction_cup" link2="wrist_2_link" reason="Never"/>
  <disable_collisions link1="suction_cup" link2="wrist_1_link" reason="Never"/>
  <disable_collisions link1="wrist_3_link" link2="wrist_1_link" reason="Never"/>
</robot>
