<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>palletizer_orchestrator</name>
  <version>0.2.0</version>
  <description>BehaviorTree.CPP v4 orchestrator for the palletizing loop, metrics logger,
    collapse detector, pick-place acceptance test and benchmark.</description>
  <maintainer email="jaisaljain345@gmail.com">jaisaljain</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>behaviortree_cpp</depend>
  <depend>palletizer_interfaces</depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>palletizer_tools</exec_depend>
  <exec_depend>tf2_msgs</exec_depend>
  <exec_depend>rviz_2d_overlay_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
