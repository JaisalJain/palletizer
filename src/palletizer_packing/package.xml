<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>palletizer_packing</name>
  <version>2.0.0</version>
  <description>Pallet packing: pure-Python core (height map, rules, planners, PyBullet checker,
    Gymnasium env) and a ROS 2 service wrapper. pybullet/gymnasium come from the project venv
    (requirements.txt).</description>
  <maintainer email="jaisaljain345@gmail.com">Jaisal K Jain</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>palletizer_interfaces</exec_depend>
  <exec_depend>palletizer_tools</exec_depend>
  <exec_depend>palletizer_motion</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
