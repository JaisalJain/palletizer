DetectedBox box
float64 mass              # measured mass [kg]; <= 0 means unknown (mass rule skipped)
bool check_only           # true: feasibility pre-check (no physics check needed)
Placement[] exclude       # targets that failed in motion for this box: plan elsewhere
bool recheck              # re-check the last plan for this box with `mass` (search again only if it fails)
---
bool success
bool pallet_full          # true: no feasible placement exists for this box
string reason             # when not success: PATTERN_COMPLETE | HEIGHT_LIMIT | NO_FEASIBLE_PLACEMENT | SKU_CHANGE | NO_PALLET
string message
Placement placement
PackingState state
