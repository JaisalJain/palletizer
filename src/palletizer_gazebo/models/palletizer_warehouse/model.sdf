      </visual>
      <visual name="interior">
        <cast_shadows>true</cast_shadows>
        <geometry><mesh><uri>model://palletizer_warehouse/meshes/warehouse_interior.obj</uri></mesh></geometry>
      </visual>
      <collision name="COL_rack_0_0">
