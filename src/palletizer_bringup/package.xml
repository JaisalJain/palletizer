<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>palletizer_bringup</name>
  <version>2.0.0</version>
  <description>Cell configuration (single source of truth) and top-level launch for the palletizing cell.</description>
  <maintainer email="jaisaljain345@gmail.com">Jaisal K Jain</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>palletizer_description</exec_depend>
  <exec_depend>palletizer_gazebo</exec_depend>
  <exec_depend>palletizer_tools</exec_depend>
  <exec_depend>palletizer_perception</exec_depend>
  <exec_depend>palletizer_moveit_config</exec_depend>
  <exec_depend>palletizer_motion</exec_depend>
  <exec_depend>palletizer_packing</exec_depend>
  <exec_depend>palletizer_orchestrator</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
