<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro">
  <!-- Reuses the joint interface block from ur_description, with gz_ros2_control hardware.
       Same pattern as ur_simulation_gz/urdf/ur_gz.ros2_control.xacro. -->
  <xacro:include filename="$(find ur_description)/urdf/inc/ur_joint_control.xacro"/>

  <xacro:macro name="palletizer_ros2_control" params="name initial_positions">
    <ros2_control name="${name}" type="system">
      <hardware>
        <plugin>gz_ros2_control/GazeboSimSystem</plugin>
      </hardware>
      <xacro:ur_joint_control_description tf_prefix="" initial_positions="${initial_positions}"/>
    </ros2_control>
  </xacro:macro>
</robot>
